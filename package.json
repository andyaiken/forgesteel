{
	"name": "forgesteel",
	"private": true,
	"version": "14.221.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"repository": "https://github.com/andyaiken/forgesteel.git",
	"homepage": "https://forgesteel.net/",
	"scripts": {
		"start": "vite --host",
		"update": "npx npm-check-updates --peer --interactive --format group",
		"lint": "eslint \"src/**/*.{ts,tsx}\" --concurrency auto",
		"lint:fix": "eslint \"src/**/*.{ts,tsx}\" --concurrency auto --fix",
		"test": "vitest",
		"check": "npm run lint && tsc -p tsconfig.json && vitest run && npm audit",
		"screenshots": "node scripts/screenshots/capture.mjs",
		"build": "vite build"
	},
	"overrides": {
		"brace-expansion": "5.0.12",
		"@babel/plugin-transform-runtime": "^7.29.0"
	},
	"dependencies": {
		"@ant-design/icons": "^6.3.4",
		"@dnd-kit/core": "^6.3.1",
		"@mdxeditor/editor": "^4.5.0",
		"antd": "^6.7.0",
		"axios": "^1.21.0",
		"dompurify": "^3.4.17",
		"fflate": "^0.8.3",
		"html2canvas": "^1.4.1",
		"jspdf": "^4.2.1",
		"localforage": "^1.10.0",
		"marked": "^18.1.3",
		"modern-screenshot": "^4.7.0",
		"rc-overflow": "^1.5.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^8.5.1",
		"sass": "^1.108.1",
		"uuid": "^14.0.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitejs/plugin-react": "^6.3.0",
		"@vitest/coverage-v8": "^5.1.0",
		"axios-mock-adapter": "^2.1.0",
		"eslint": "^10.14.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.14.0",
		"playwright": "^1.65.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6",
		"vite-plugin-pwa": "^2.0.0",
		"vitest": "^5.1.0",
		"workbox-build": "^7.4.1",
		"workbox-window": "^7.4.1"
