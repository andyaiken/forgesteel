{
	"name": "forgesteel",
	"private": true,
	"version": "14.200.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"repository": "https://github.com/andyaiken/forgesteel.git",
	"homepage": "https://forgesteel.net/",
	"scripts": {
		"start": "vite --host",
		"update": "npx npm-check-updates --peer --interactive --format group",
		"lint": "eslint \"src/**/*.{ts,tsx}\" --concurrency auto",
		"lint:fix": "eslint \"src/**/*.{ts,tsx}\" --concurrency auto --fix",
		"test": "vitest",
		"check": "npm run lint && tsc -p tsconfig.json && vitest run && npm audit",
		"screenshots": "node scripts/screenshots/capture.mjs",
		"build": "vite build"
	},
	"overrides": {
		"brace-expansion": "5.0.8"
	},
	"dependencies": {
		"@ant-design/icons": "^6.3.4",
		"@dnd-kit/core": "^6.3.1",
		"@mdxeditor/editor": "^4.2.5",
		"antd": "^6.6.4",
		"axios": "^1.20.0",
		"dompurify": "^3.4.15",
		"fflate": "^0.8.3",
		"html2canvas": "^1.4.1",
		"jspdf": "^4.2.1",
		"localforage": "^1.10.0",
		"marked": "^18.0.13",
		"modern-screenshot": "^4.7.0",
		"rc-overflow": "^1.5.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-router": "^8.4.0",
		"sass": "^1.104.1",
		"uuid": "^14.0.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.0.5",
		"@vitest/coverage-v8": "^5.0.1",
		"axios-mock-adapter": "^2.1.0",
		"eslint": "^10.10.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.12.0",
		"playwright": "^1.63.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.3.0",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^5.0.1",
		"workbox-build": "^7.4.1",
		"workbox-window": "^7.4.1"
	}
}
